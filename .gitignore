# Local-only sync tools: they copy the landing tour and the meadow scenes in
# from the authoring sources under .claude/ (not in the repo), so they cannot
# run from a clone. Their OUTPUT (public/landing/, src/landing/meadow/) is the
# product and is committed.
scripts/sync-landing-ad.mjs
scripts/sync-meadow.mjs
.pytest_cache/
__pycache__/
*.py[cod]

# Local authoring/analysis tooling — not part of the shipped app. The
# generated modules under src/soundDefinitions/instruments/ are the
# product; nothing in the app imports either directory.
samples/
tools/

